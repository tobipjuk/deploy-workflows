   ],
   "Resource": "arn:aws:s3:::ev3-workshop-deploy-880207437749/deployed-manifest.json"
  },
  {
   "Sid": "ManifestListOwnKey",
   "Effect": "Allow",
   "Action": [
    "s3:ListBucket"
   ],
   "Resource": "arn:aws:s3:::ev3-workshop-deploy-880207437749",
   "Condition": {
    "StringEquals": {
     "s3:prefix": [
      "deployed-manifest.json"
     ]
    }
   }
  },
  {
   "Sid": "DenyEverythingElse",
   "Effect": "Deny",
   "NotAction": [
    "s3:GetObject",
    "s3:ListBucket",
    "lambda:GetFunction",
    "lambda:GetFunctionConfiguration",
    "cloudfront:GetFunction",
    "cloudfront:DescribeFunction"
   ],
   "Resource": "*"
  },
  {
   "Sid": "DenySecrets",
   "Effect": "Deny",
   "Resource": "*",
   "Action": [
    "cloudfront-keyvaluestore:*",
    "secretsmanager:GetSecretValue",
    "kms:Decrypt"
   ]
  }
 ]
